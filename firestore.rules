rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: synced profile data for chat
    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    // Chat threads and messages
    match /chats/{threadId} {
      allow read, write: if request.auth != null;
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // Orders collection: synced from local SQLite, admin reads all, user reads own
    match /orders/{invoiceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Fallback: allow authenticated users to read/write anything not matched above
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
